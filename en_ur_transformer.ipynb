      },
      "outputs": [],
      "source": [
        "# ============================================================================\n",
        "# Cell 2: Vocabulary and Tokenization Classes\n",
        "# ============================================================================\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "class Tokenizer:\n",
        "    \"\"\"Simple tokenizer for text processing\"\"\"\n",
        "\n",
        "    def __init__(self, language='en'):\n",
        "        self.language = language\n",
        "\n",
        "    def tokenize(self, text):\n",
        "        \"\"\"Tokenize text into words\"\"\"\n",
        "        text = text.lower().strip()          #normalize text\n",
        "        # Basic tokenization - split by spaces and punctuation\n",
        "        if self.language == 'en':\n",
        "            tokens = re.findall(r'\\w+|[^\\w\\s]', text)      #split by words and keep punctuation as separate tokens\n",
        "        else:  # Urdu\n",
        "            # Keep Urdu characters together\n",
        "            tokens = text.split()\n",
        "        return tokens\n",
        "\n",
        "\n",
        "class Vocabulary:\n",
        "    \"\"\"Vocabulary class for managing word-to-index mappings\"\"\"\n",
        "\n",
        "    def __init__(self, tokenizer):\n",
        "        self.tokenizer = tokenizer\n",
        "        self.word2idx = {'<pad>': 0, '<sos>': 1, '<eos>': 2, '<unk>': 3}\n",
        "        self.idx2word = {0: '<pad>', 1: '<sos>', 2: '<eos>', 3: '<unk>'}\n",
        "        self.word_count = Counter()\n",
        "\n",
        "    def build_vocabulary(self, sentences, min_freq=2):\n",
        "        \"\"\"Build vocabulary from sentences\"\"\"\n",
        "        # Count words\n",
        "        for sentence in sentences:\n",
        "            tokens = self.tokenizer.tokenize(sentence)\n",
        "            self.word_count.update(tokens)\n",
        "\n",
        "        # Add words to vocabulary based on frequency\n",
        "        idx = len(self.word2idx)\n",
        "        for word, count in self.word_count.items():             \n",
        "            if count >= min_freq and word not in self.word2idx:       #remove rare words to reduce vocabulary size and improve generalization\n",
        "                self.word2idx[word] = idx\n",
        "                self.idx2word[idx] = word\n",
        "                idx += 1\n",
        "\n",
        "        print(f\"Vocabulary size: {len(self.word2idx)}\")\n",
        "\n",
        "    def encode(self, sentence):\n",
        "        \"\"\"Convert sentence to indices\"\"\"\n",
        "        tokens = self.tokenizer.tokenize(sentence)\n",
        "        return [self.word2idx.get(token, self.word2idx['<unk>']) for token in tokens]\n",
        "\n",
        "    def decode(self, indices):\n",
        "        \"\"\"Convert indices back to sentence\"\"\"\n",
        "        return ' '.join([self.idx2word.get(idx, '<unk>') for idx in indices])\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.word2idx)\n",
        "    \n",
        "\n",
        "   "
      ]
    },
