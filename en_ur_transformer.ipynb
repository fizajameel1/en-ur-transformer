        "# ============================================================================\n",
        "# Cell 11: Load and Preprocess Data\n",
        "# ============================================================================\n",
        "\n",
        "def load_data(en_path, ur_path, max_samples=None):\n",
        "    \"\"\"Load parallel corpus\"\"\"\n",
        "    print(\"Loading data...\")\n",
        "\n",
        "    with open(en_path, 'r', encoding='utf-8') as f:\n",
        "        en_sentences = [line.strip() for line in f.readlines()]\n",
        "\n",
        "    with open(ur_path, 'r', encoding='utf-8') as f:\n",
        "        ur_sentences = [line.strip() for line in f.readlines()]\n",
        "\n",
        "    # Ensure equal number of sentences\n",
        "    assert len(en_sentences) == len(ur_sentences), \"Mismatched corpus sizes\"\n",
        "\n",
        "    # Limit samples if specified\n",
        "    if max_samples:\n",
        "        en_sentences = en_sentences[:max_samples]\n",
        "        ur_sentences = ur_sentences[:max_samples]\n",
        "\n",
        "    print(f\"Loaded {len(en_sentences)} sentence pairs\")\n",
        "    return en_sentences, ur_sentences\n",
        "\n",
        "\n",
        "def prepare_data(en_sentences, ur_sentences, train_split=0.9):\n",
        "    \"\"\"Prepare vocabularies and datasets\"\"\"\n",
        "\n",
        "    # Split into train and validation\n",
        "    split_idx = int(len(en_sentences) * train_split)\n",
        "\n",
        "    train_en = en_sentences[:split_idx]\n",
        "    train_ur = ur_sentences[:split_idx]\n",
        "    val_en = en_sentences[split_idx:]\n",
        "    val_ur = ur_sentences[split_idx:]\n",
        "\n",
        "    print(f\"Train size: {len(train_en)}, Val size: {len(val_en)}\")\n",
        "\n",
        "    # Create tokenizers\n",
        "    en_tokenizer = Tokenizer('en')\n",
        "    ur_tokenizer = Tokenizer('ur')\n",
        "\n",
        "    # Build vocabularies\n",
        "    print(\"Building vocabularies...\")\n",
        "    src_vocab = Vocabulary(en_tokenizer)\n",
        "    tgt_vocab = Vocabulary(ur_tokenizer)\n",
        "\n",
        "    src_vocab.build_vocabulary(train_en, min_freq=2)\n",
        "    tgt_vocab.build_vocabulary(train_ur, min_freq=2)\n",
        "\n",
        "    # Create datasets\n",
        "    train_dataset = TranslationDataset(train_en, train_ur, src_vocab, tgt_vocab)\n",
        "    val_dataset = TranslationDataset(val_en, val_ur, src_vocab, tgt_vocab)\n",
        "\n",
        "    return train_dataset, val_dataset, src_vocab, tgt_vocab\n",
        "\n",
        "\n",
        "# Load data (adjust max_samples based on your memory constraints)\n",
        "en_sentences, ur_sentences = load_data(\n",
        "    './dataset/q2/english-corpus.txt',\n",
        "    './dataset/q2/urdu-corpus.txt',\n",
        "    max_samples=20000  # Use all samples or reduce if needed\n",
        ")\n",
        "\n",
        "# Prepare data\n",
        "train_dataset, val_dataset, src_vocab, tgt_vocab = prepare_data(\n",
        "    en_sentences, ur_sentences\n",
        ")\n"
      ]
    },
