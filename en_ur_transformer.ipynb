      "source": [
        "# ============================================================================\n",
        "# Cell 14: Training Functions\n",
        "# ============================================================================\n",
        "\n",
        "def train_epoch(model, loader, criterion, optimizer, epoch, step):\n",
        "    \"\"\"Train for one epoch\"\"\"\n",
        "    model.train()\n",
        "    total_loss = 0\n",
        "\n",
        "    pbar = tqdm(loader, desc=f\"Epoch {epoch+1} [Train]\")\n",
        "    for src, tgt in pbar:\n",
        "        src = src.to(device)\n",
        "        tgt = tgt.to(device)\n",
        "\n",
        "        # Prepare input and target\n",
        "        tgt_input = tgt[:, :-1]\n",
        "        tgt_output = tgt[:, 1:]\n",
        "\n",
        "        # Update learning rate\n",
        "        step += 1\n",
        "        lr = get_lr(step, D_MODEL, WARMUP_STEPS)\n",
        "        for param_group in optimizer.param_groups:\n",
        "            param_group['lr'] = lr\n",
        "\n",
        "        # Forward pass\n",
        "        optimizer.zero_grad()\n",
        "        output = model(src, tgt_input)\n",
        "\n",
        "        # Calculate loss\n",
        "        output = output.reshape(-1, output.size(-1))\n",
        "        tgt_output = tgt_output.reshape(-1)\n",
        "        loss = criterion(output, tgt_output)\n",
        "\n",
        "        # Backward pass\n",
        "        loss.backward()\n",
        "        torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)      # Gradient clipping to prevent exploding gradients\n",
        "        optimizer.step()\n",
        "\n",
        "        total_loss += loss.item()\n",
        "        pbar.set_postfix({'loss': loss.item(), 'lr': lr})\n",
        "\n",
        "    return total_loss / len(loader), step\n",
        "\n",
        "\n",
        "def validate(model, loader, criterion):\n",
        "    \"\"\"Validate the model\"\"\"\n",
        "    model.eval()\n",
        "    total_loss = 0\n",
        "\n",
        "    with torch.no_grad():\n",
        "        pbar = tqdm(loader, desc=\"Validation\")\n",
        "        for src, tgt in pbar:\n",
        "            src = src.to(device)\n",
        "            tgt = tgt.to(device)\n",
        "\n",
        "            tgt_input = tgt[:, :-1]\n",
        "            tgt_output = tgt[:, 1:]\n",
        "\n",
        "            output = model(src, tgt_input)\n",
        "\n",
        "            output = output.reshape(-1, output.size(-1))\n",
        "            tgt_output = tgt_output.reshape(-1)\n",
        "            loss = criterion(output, tgt_output)\n",
        "\n",
        "            total_loss += loss.item()\n",
        "            pbar.set_postfix({'loss': loss.item()})\n",
        "\n",
        "    return total_loss / len(loader)\n",
        "\n",
        "#pretraining\n",
        "from transformers import MBartForConditionalGeneration, MBart50TokenizerFast\n",
        "\n",
        "tokenizer = MBart50TokenizerFast.from_pretrained(\"facebook/mbart-large-50\")\n",
        "tokenizer.src_lang = \"en_XX\"\n",
        "\n",
        "model_mbart = MBartForConditionalGeneration.from_pretrained(\"facebook/mbart-large-50\").to(device)\n",
        "\n",
        "def mbart_translate(text):\n",
        "    inputs = tokenizer(text, return_tensors=\"pt\").to(device)\n",
        "\n",
        "    generated = model_mbart.generate(\n",
        "        **inputs,\n",
        "        forced_bos_token_id=tokenizer.lang_code_to_id[\"ur_PK\"]\n",
        "    )\n",
        "\n",
        "    return tokenizer.decode(generated[0], skip_special_tokens=True)\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "from transformers import AutoTokenizer\n",
        "\n",
        "subword_tokenizer = AutoTokenizer.from_pretrained(\"facebook/mbart-large-50\")\n",
        "\n",
        "def encode_text(text):\n",
        "    return subword_tokenizer(text, truncation=True, padding=\"max_length\", max_length=50)\n",
        "\n",
        "def decode_tokens(tokens):\n",
        "    return subword_tokenizer.decode(tokens, skip_special_tokens=True) \n"
      ]
    },
