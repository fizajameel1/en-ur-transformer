        "# ============================================================================\n",
        "# Cell 23: Analyze Model Performance\n",
        "# ============================================================================\n",
        "\n",
        "def analyze_translations(model, dataset, src_vocab, tgt_vocab, num_samples=10):\n",
        "    \"\"\"Analyze translation quality with detailed metrics\"\"\"\n",
        "    print(\"\\nDetailed Translation Analysis\")\n",
        "    print(\"=\" * 80)\n",
        "\n",
        "    bleu_scores = []\n",
        "\n",
        "    for i in range(min(num_samples, len(dataset))):\n",
        "        src_sentence = dataset.src_sentences[i]\n",
        "        ref_translation = dataset.tgt_sentences[i]\n",
        "\n",
        "        # Get translations\n",
        "        pred_greedy = translate(model, src_sentence, src_vocab, tgt_vocab)\n",
        "        pred_beam = beam_search_translate(model, src_sentence, src_vocab,\n",
        "                                         tgt_vocab, beam_size=4)\n",
        "\n",
        "        # Calculate BLEU scores\n",
        "        bleu_greedy = calculate_bleu(ref_translation, pred_greedy)\n",
        "        bleu_beam = calculate_bleu(ref_translation, pred_beam)\n",
        "\n",
        "        bleu_scores.append((bleu_greedy, bleu_beam))\n",
        "\n",
        "        print(f\"\\nSample {i + 1}:\")\n",
        "        print(f\"Source:           {src_sentence}\")\n",
        "        print(f\"Reference:        {ref_translation}\")\n",
        "        print(f\"Greedy (BLEU={bleu_greedy:.3f}): {pred_greedy}\")\n",
        "        print(f\"Beam   (BLEU={bleu_beam:.3f}): {pred_beam}\")\n",
        "        print(\"-\" * 80)\n",
        "\n",
        "    # Calculate average BLEU scores\n",
        "    avg_bleu_greedy = sum(b[0] for b in bleu_scores) / len(bleu_scores)\n",
        "    avg_bleu_beam = sum(b[1] for b in bleu_scores) / len(bleu_scores)\n",
        "\n",
        "    print(f\"\\nAverage BLEU Score (Greedy): {avg_bleu_greedy:.4f}\")\n",
        "    print(f\"Average BLEU Score (Beam):   {avg_bleu_beam:.4f}\")\n",
        "\n",
        "\n",
        "# Run analysis\n",
        "analyze_translations(model, val_dataset, src_vocab, tgt_vocab, num_samples=10)\n"
      ]
    },
