        "# ============================================================================\n",
        "# Cell 26: Model Export for Inference\n",
        "# ============================================================================\n",
        "\n",
        "class TranslatorInference:\n",
        "    \"\"\"Wrapper class for easy inference\"\"\"\n",
        "\n",
        "    def __init__(self, model_path, src_vocab_path, tgt_vocab_path):\n",
        "        # Load vocabularies\n",
        "        with open(src_vocab_path, 'rb') as f:\n",
        "            self.src_vocab = pickle.load(f)\n",
        "        with open(tgt_vocab_path, 'rb') as f:\n",
        "            self.tgt_vocab = pickle.load(f)\n",
        "\n",
        "        # Load model\n",
        "        self.device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "        checkpoint = torch.load(model_path, map_location=self.device)\n",
        "\n",
        "        # Initialize model architecture\n",
        "        self.model = Transformer(\n",
        "            src_vocab_size=len(self.src_vocab),\n",
        "            tgt_vocab_size=len(self.tgt_vocab),\n",
        "            d_model=D_MODEL,\n",
        "            num_layers=NUM_LAYERS,\n",
        "            num_heads=NUM_HEADS,\n",
        "            d_ff=D_FF,\n",
        "            max_len=MAX_LEN,\n",
        "            dropout=DROPOUT\n",
        "        ).to(self.device)\n",
        "\n",
        "        self.model.load_state_dict(checkpoint['model_state_dict'])\n",
        "        self.model.eval()\n",
        "\n",
        "    def translate(self, sentence, use_beam_search=True, beam_size=4):\n",
        "        \"\"\"Translate a sentence\"\"\"\n",
        "        if use_beam_search:\n",
        "            return beam_search_translate(\n",
        "                self.model, sentence, self.src_vocab,\n",
        "                self.tgt_vocab, beam_size\n",
        "            )\n",
        "        else:\n",
        "            return translate(\n",
        "                self.model, sentence, self.src_vocab, self.tgt_vocab\n",
        "            )\n",
        "\n",
        "\n",
        "# Example usage:\n",
        "# translator = TranslatorInference(\n",
        "#     'best_transformer_model.pt',\n",
        "#     'src_vocab.pkl',\n",
