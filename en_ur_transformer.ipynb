        "# ============================================================================\n",
        "# Cell 12: Training Configuration\n",
        "# ============================================================================\n",
        "\n",
        "# Hyperparameters - Optimized for better generalization and longer training\n",
        "BATCH_SIZE = 64  # Increased for better gradient estimates\n",
        "D_MODEL = 512  # Standard size from paper - better capacity\n",
        "NUM_LAYERS = 6  # Full 6 layers as in paper\n",
        "NUM_HEADS = 8\n",
        "D_FF = 2048  # Standard size from paper\n",
        "MAX_LEN = 100\n",
        "DROPOUT = 0.3  # Increased to combat overfitting (you had 0.1, which was too low)\n",
        "LEARNING_RATE = 0.0001  # Will be scheduled anyway\n",
        "NUM_EPOCHS = 50  # Longer training for 8-hour budget\n",
        "WARMUP_STEPS = 8000  # Increased warmup for stability\n",
        "LABEL_SMOOTHING = 0.1  # Add label smoothing\n",
        "\n",
        "# Gradient clipping\n",
        "GRAD_CLIP = 1.0\n",
        "\n",
        "# Early stopping patience\n",
        "EARLY_STOP_PATIENCE = 10\n",
        "\n",
        "print(f\"Configuration:\")\n",
        "print(f\"  Model size: {D_MODEL}D, {NUM_LAYERS} layers, {NUM_HEADS} heads\")\n",
        "print(f\"  Training: {NUM_EPOCHS} epochs, batch size {BATCH_SIZE}\")\n",
        "print(f\"  Regularization: dropout={DROPOUT}, label_smoothing={LABEL_SMOOTHING}\")     #label smoothing helps prevent the model from becoming too confident in its predictions, which can improve generalization and reduce overfitting\n",
        "print(f\"  Estimated time: ~{NUM_EPOCHS * 30 / 3600:.1f} hours\")\n",
        "\n",
        "# Create data loaders\n",
        "train_loader = DataLoader(\n",
        "    train_dataset,\n",
        "    batch_size=BATCH_SIZE,\n",
        "    shuffle=True,\n",
        "    collate_fn=collate_fn,\n",
        "    num_workers=0\n",
        ")\n",
        "\n",
        "val_loader = DataLoader(\n",
        "    val_dataset,\n",
        "    batch_size=BATCH_SIZE,\n",
        "    shuffle=False,\n",
        "    collate_fn=collate_fn,\n",
        "    num_workers=0\n",
        ")\n",
        "\n",
        "print(f\"Number of training batches: {len(train_loader)}\")\n",
        "print(f\"Number of validation batches: {len(val_loader)}\")"
      ]
