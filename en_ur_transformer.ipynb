        "# ============================================================================\n",
        "# Cell 17: Translation Function (Greedy Decoding)\n",
        "# ============================================================================\n",
        "\n",
        "def translate(model, src_sentence, src_vocab, tgt_vocab, max_len=50):\n",
        "    \"\"\"Translate a sentence using greedy decoding\"\"\"\n",
        "    model.eval()\n",
        "\n",
        "    # Encode source sentence\n",
        "    src_indices = [src_vocab.word2idx['<sos>']] + \\\n",
        "                  src_vocab.encode(src_sentence) + \\\n",
        "                  [src_vocab.word2idx['<eos>']]\n",
        "    src = torch.tensor(src_indices).unsqueeze(0).to(device)\n",
        "\n",
        "    # Start with <sos> token\n",
        "    tgt_indices = [tgt_vocab.word2idx['<sos>']]\n",
        "\n",
        "    with torch.no_grad():\n",
        "        for _ in range(max_len):\n",
        "            tgt = torch.tensor(tgt_indices).unsqueeze(0).to(device)\n",
        "\n",
        "            # Forward pass\n",
        "            output = model(src, tgt)\n",
        "\n",
        "            # Get the last token prediction\n",
        "            next_token_logits = output[0, -1, :]\n",
        "            next_token = torch.argmax(next_token_logits).item()\n",
        "\n",
        "            # Add to output\n",
        "            tgt_indices.append(next_token)\n",
        "\n",
        "            # Stop if <eos> token is generated\n",
        "            if next_token == tgt_vocab.word2idx['<eos>']:\n",
        "                break\n",
        "\n",
        "    # Decode to words (remove <sos> and <eos>)\n",
        "    translated_words = []\n",
        "    for idx in tgt_indices[1:-1]:  # Skip <sos> and <eos>\n",
        "        if idx in tgt_vocab.idx2word:\n",
        "            translated_words.append(tgt_vocab.idx2word[idx])\n",
        "\n",
        "    return ' '.join(translated_words)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "a4dfe451-87d7-496d-b9f7-b779d9324fdc",
