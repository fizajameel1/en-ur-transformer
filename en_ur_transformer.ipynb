      "source": [
        "# ============================================================================\n",
        "# Cell 18: Beam Search Translation (Optional but Better)\n",
        "# ============================================================================\n",
        "\n",
        "def beam_search_translate(model, src_sentence, src_vocab, tgt_vocab,\n",
        "                         beam_size=4, max_len=50):\n",
        "    \"\"\"Translate using beam search for better results\"\"\"\n",
        "    model.eval()\n",
        "\n",
        "    # Encode source sentence\n",
        "    src_indices = [src_vocab.word2idx['<sos>']] + \\\n",
        "                  src_vocab.encode(src_sentence) + \\\n",
        "                  [src_vocab.word2idx['<eos>']]\n",
        "    src = torch.tensor(src_indices).unsqueeze(0).to(device)\n",
        "\n",
        "    # Initialize beams: (sequence, score)\n",
        "    beams = [([tgt_vocab.word2idx['<sos>']], 0.0)]\n",
        "\n",
        "    with torch.no_grad():\n",
        "        for _ in range(max_len):\n",
        "            new_beams = []\n",
        "\n",
        "            for sequence, score in beams:\n",
        "                # Skip if sequence ends with <eos>\n",
        "                if sequence[-1] == tgt_vocab.word2idx['<eos>']:\n",
        "                    new_beams.append((sequence, score))\n",
        "                    continue\n",
        "\n",
        "                tgt = torch.tensor(sequence).unsqueeze(0).to(device)\n",
        "\n",
        "                # Forward pass\n",
        "                output = model(src, tgt)\n",
        "\n",
        "                # Get probabilities for next token\n",
        "                next_token_logits = output[0, -1, :]\n",
        "                log_probs = torch.log_softmax(next_token_logits, dim=-1)\n",
        "\n",
        "                # Get top k tokens\n",
        "                top_log_probs, top_indices = torch.topk(log_probs, beam_size)\n",
        "\n",
        "                # Create new beams\n",
        "                for log_prob, idx in zip(top_log_probs, top_indices):\n",
        "                    new_sequence = sequence + [idx.item()]\n",
        "                    new_score = score + log_prob.item()\n",
        "                    new_beams.append((new_sequence, new_score))\n",
        "\n",
        "            # Keep top beam_size beams\n",
        "            beams = sorted(new_beams, key=lambda x: x[1], reverse=True)[:beam_size]\n",
        "\n",
        "            # Check if all beams ended\n",
        "            if all(seq[-1] == tgt_vocab.word2idx['<eos>'] for seq, _ in beams):\n",
        "                break\n",
        "\n",
        "    # Get best sequence\n",
        "    best_sequence, _ = beams[0]\n",
        "\n",
        "    # Decode to words\n",
        "    translated_words = []\n",
        "    for idx in best_sequence[1:-1]:  # Skip <sos> and <eos>\n",
        "        if idx in tgt_vocab.idx2word:\n",
        "            translated_words.append(tgt_vocab.idx2word[idx])\n",
        "\n",
        "    return ' '.join(translated_words)"
      ]
    },
