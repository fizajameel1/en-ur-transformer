        "# ============================================================================\n",
        "# Cell 19: BLEU Score Calculation\n",
        "# ============================================================================\n",
        "\n",
        "from collections import Counter\n",
        "\n",
        "def get_ngrams(tokens, n):\n",
        "    \"\"\"Get n-grams from tokens\"\"\"\n",
        "    ngrams = []\n",
        "    for i in range(len(tokens) - n + 1):\n",
        "        ngrams.append(tuple(tokens[i:i+n]))\n",
        "    return ngrams\n",
        "\n",
        "\n",
        "def calculate_bleu(reference, candidate, max_n=4):\n",
        "    \"\"\"\n",
        "    Calculate BLEU score\n",
        "    Args:\n",
        "        reference: reference translation (string)\n",
        "        candidate: candidate translation (string)\n",
        "        max_n: maximum n-gram order (default 4)\n",
        "    \"\"\"\n",
        "    # Tokenize\n",
        "    ref_tokens = reference.split()\n",
        "    cand_tokens = candidate.split()\n",
        "\n",
        "    # Calculate brevity penalty\n",
        "    ref_len = len(ref_tokens)\n",
        "    cand_len = len(cand_tokens)\n",
        "\n",
        "    if cand_len == 0:\n",
        "        return 0.0\n",
        "\n",
        "    if cand_len > ref_len:\n",
        "        bp = 1.0\n",
        "    else:\n",
        "        bp = math.exp(1 - ref_len / cand_len)\n",
        "\n",
        "    # Calculate precision for each n-gram order\n",
        "    precisions = []\n",
        "    for n in range(1, max_n + 1):\n",
        "        ref_ngrams = Counter(get_ngrams(ref_tokens, n))\n",
        "        cand_ngrams = Counter(get_ngrams(cand_tokens, n))\n",
        "\n",
        "        # Count matches\n",
        "        matches = 0\n",
        "        total = 0\n",
        "        for ngram in cand_ngrams:\n",
        "            matches += min(cand_ngrams[ngram], ref_ngrams.get(ngram, 0))\n",
        "            total += cand_ngrams[ngram]\n",
        "\n",
        "        if total == 0:\n",
        "            precisions.append(0)\n",
        "        else:\n",
        "            precisions.append(matches / total)\n",
        "\n",
        "    # Calculate geometric mean\n",
        "    if min(precisions) == 0:\n",
        "        return 0.0\n",
        "\n",
        "    log_precision_sum = sum(math.log(p) for p in precisions)\n",
        "    geo_mean = math.exp(log_precision_sum / max_n)\n",
        "\n",
        "    bleu = bp * geo_mean\n",
        "    return bleu\n",
        "\n",
        "\n",
        "def evaluate_bleu(model, dataset, src_vocab, tgt_vocab, num_samples=100):\n",
        "    \"\"\"Evaluate BLEU score on dataset\"\"\"\n",
        "    total_bleu = 0\n",
        "\n",
        "    print(f\"Calculating BLEU score on {num_samples} samples...\")\n",
        "\n",
        "    for i in tqdm(range(min(num_samples, len(dataset)))):\n",
        "        src_sentence = dataset.src_sentences[i]\n",
        "        ref_sentence = dataset.tgt_sentences[i]\n",
        "\n",
        "        # Translate\n",
        "        translation = translate(model, src_sentence, src_vocab, tgt_vocab)\n",
        "\n",
        "        # Calculate BLEU\n",
        "        bleu = calculate_bleu(ref_sentence, translation)\n",
        "        total_bleu += bleu\n",
        "\n",
        "    avg_bleu = total_bleu / min(num_samples, len(dataset))\n",
        "    return avg_bleu\n"
      ]
    },
